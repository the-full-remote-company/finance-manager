# Copy to .env.local. Placeholders only — never a real secret.
# Article VIII: secrets live only in environment configuration, and a secret
# committed to this repository MUST be rotated, not merely removed.

# Migrations only. Owns the tables; row level security does not apply to it.
DATABASE_URL_OWNER=postgres://owner:owner@localhost:5432/finance

# Runtime. Non-owner, non-superuser, NOBYPASSRLS. The application uses only this.
DATABASE_URL=postgres://app:app@localhost:5432/finance

# Session cookie. The __Host- prefix requires Secure, path=/ and no Domain.
SESSION_COOKIE_NAME=__Host-session

# Sessions last this long; a session is also revocable server-side.
SESSION_TTL_HOURS=720

# Failed sign-in throttling (FR-005).
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_MINUTES=15
