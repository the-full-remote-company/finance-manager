# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
# Serwist's InjectManifest output (T098): rebuilt by every `next build`, with
# a content hash that changes per build, so a committed copy would always be
# stale relative to the build that actually shipped.
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js
# Regenerated on every `next dev`/`next build`; its own content imports
# generated type files under `.next/`, which is itself ignored above, so a
# committed copy would import a path nobody but the last builder's machine has.
next-env.d.ts

# Test / coverage output
coverage/
playwright-report/
test-results/
blob-report/
.nyc_output/

# Environment — secrets never enter this repository (constitution, Article VIII)
.env
.env.*
!.env.example

# Turborepo
.turbo/

# Editor / OS
.DS_Store
.idea/
*.swp

# Machine-local agent config: contains a personal Google Cloud project id.
# Remove this line if the team wants a shared committed config.
opencode.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Personal financial data — MUST NOT be committed (public repo)
Finanz*.xlsx
*.xlsx
*.csv
