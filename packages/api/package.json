{
  "name": "@finance/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
