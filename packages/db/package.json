{
  "name": "@finance/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./rls": "./src/rls.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "reset": "node ./scripts/reset.mjs",
    "seed:dev": "node ./scripts/seed-dev.mjs",
    "verify:generated-columns": "node ./scripts/verify-generated-columns.mjs"
  },
  "dependencies": {
    "@finance/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
