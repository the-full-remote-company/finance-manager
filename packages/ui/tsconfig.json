{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // TypeScript 6 no longer loads every installed @types/* package on its
    // own. This package's tests read files through node:fs, node:path and
    // node:url, so it names the one it needs. Deliberately not in
    // tsconfig.base.json: packages/core must stay free of Node globals
    // (Article VI).
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
